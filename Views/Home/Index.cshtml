@{
    ViewData["Title"] = "Главная";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">🎓 Студенческий портал</h1>
        <p class="lead text-muted">Система управления студентами университета</p>
    </div>

    <div class="row g-4 justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card h-100 shadow-sm rounded-4 text-center">
                <div class="card-body d-flex flex-column">
                    <div class="display-4 mb-3">📋</div>
                    <h3 class="card-title">Каталог</h3>
                    <p class="card-text text-muted flex-grow-1">Просмотр всех студентов с поиском и деталями</p>
                    <a asp-controller="Student" asp-action="Index" class="btn btn-primary">Открыть каталог</a>
                </div>
            </div>
        </div>

        <div class="col-md-5 col-lg-4">
            <div class="card h-100 shadow-sm rounded-4 text-center">
                <div class="card-body d-flex flex-column">
                    <div class="display-4 mb-3">➕</div>
                    <h3 class="card-title">Добавить</h3>
                    <p class="card-text text-muted flex-grow-1">Добавить нового студента в систему</p>
                    <a asp-controller="Student" asp-action="Create" class="btn btn-success">Добавить студента</a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Student Portal v1.0 -->